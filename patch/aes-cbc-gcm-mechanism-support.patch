--- a/gck-rpc-util.c
+++ b/gck-rpc-util.c
@@ -30,6 +30,16 @@
 #include <string.h>
 #include <stdio.h>
 
+/*
+ * The pkcs11.h bundled with this project (pkcs11/pkcs11.h) implements
+ * PKCS#11 v2.20. CKM_AES_GCM was only added in PKCS#11 v2.40, so on
+ * builds using the bundled header it's undefined. Value taken from the
+ * official PKCS#11 v2.40 mechanism list (OASIS PKCS11-spec-v2.40).
+ */
+#ifndef CKM_AES_GCM
+#define CKM_AES_GCM 0x00001087
+#endif
+
 static void do_log(const char *pref, const char *msg, va_list va)
 {
 	char buffer[1024];
@@ -96,6 +106,20 @@
 	switch (type) {
 	case CKM_RSA_PKCS_OAEP:
 	case CKM_RSA_PKCS_PSS:
+	/*
+	 * CKM_AES_CBC / CKM_AES_CBC_PAD take a plain 16-byte IV as
+	 * pParameter, and CKM_AES_GCM takes a CK_GCM_PARAMS whose IV/AAD
+	 * fields are themselves flat byte buffers. Both are safe to
+	 * forward as an opaque byte array across the RPC link, same as
+	 * the RSA-OAEP/PSS params above. Without these, proto_write_mechanism()
+	 * in gck-rpc-module.c rejects the mechanism locally with
+	 * CKR_MECHANISM_INVALID before ever contacting the daemon, and
+	 * gck_rpc_mechanism_list_purge() strips them out of
+	 * C_GetMechanismList() results.
+	 */
+	case CKM_AES_CBC:
+	case CKM_AES_CBC_PAD:
+	case CKM_AES_GCM:
 		return 1;
 	default:
 		return 0;
